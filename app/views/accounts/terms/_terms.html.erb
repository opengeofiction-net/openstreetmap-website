<%# locals: (text:) %>
<%# OpenGeofiction: three numbered sections, each with optional lettered points -
    see config/legales/US.yml. Upstream's eight-section OSMF layout does not fit. %>

<p id="first">
  <%= text["intro"] %>
  <%= text["next_with_decline"] %>
</p>
<% [["introduction", "section_1"], ["rights_granted", "section_2"], ["miscellaneous", "section_3"]].each_with_index do |(heading, section), i| %>
  <h3><%= text[heading] %></h3>
  <ol start="<%= i + 1 %>">
    <li>
      <p<%= ' id="last"'.html_safe if section == "section_3" %>><%= text[section] %></p>
      <% points = %w[a b c d].filter_map { |l| text["#{section}#{l}"] } %>
      <% unless points.empty? %>
        <ol>
          <% points.each do |point| %>
            <li><%= point %></li>
          <% end %>
        </ol>
      <% end %>
    </li>
  </ol>
<% end %>
